# ---- Local development (copy to .env). For production use real values, see README ----
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
ADMIN_URL=admin

# Generate with: python manage.py gen_keys  (required when DEBUG=False)
DATA_ENCRYPTION_KEYS=
HASH_PEPPER=

# Database / cache. Empty = SQLite + in-memory cache. Production: Postgres + Redis.
DATABASE_URL=
REDIS_URL=
CELERY_EAGER=True

# Bot protection. These are Cloudflare's public TEST keys (always pass). Use real keys in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Sending. console + mock = fully local demo. Production must use twilio + stripe.
SMS_ENABLED=True
SMS_PROVIDER=console
PAYMENT_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PRICE_PER_SEGMENT_CENTS=149
CURRENCY=usd
MAX_SEGMENTS=4
MESSAGE_TTL_HOURS=48
DAILY_LIMIT_PER_RECIPIENT=2
DAILY_LIMIT_PER_IP=5
BLOCKED_COUNTRIES=
NUM_PROXIES=0

# Scanner extras (optional)
BLOCK_THRESHOLD=60
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GOOGLE_SAFE_BROWSING_API_KEY=
